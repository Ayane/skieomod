      "min": 1,
      "max": 1
    },
    "tags": [
      "Alps",
      "France",
      "Nature",
      "Sandbox"
    ],
    "license": "IGN Open Licence v2.0 data and OpenStreetMap ODbL 1.0",
    "localizations": {
      "fr": {
        "description": "Créez votre échappée alpine au cœur du Vercors. De Gresse-en-Vercors au Grand Veymont et au Mont Aiguille, explorez les forêts enneigées et les grandes prairies, développez une station de 20 pistes et neuf remontées, et guettez les renards discrets qui se faufilent entre les arbres.",
        "license": "Données IGN Licence Ouverte v2.0 et OpenStreetMap ODbL 1.0"
