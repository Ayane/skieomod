{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {"community": {"projectType": "application", "root": "", "sourceRoot": "src", "architect": {
    "build": {"builder": "@angular/build:application", "options": {"browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "outputPath": "dist", "assets": [{"glob": "**/*", "input": "public", "output": "/"}]}, "configurations": {"production": {"optimization": {"scripts": true, "styles": {"minify": true, "inlineCritical": false}}, "outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "700kB", "maximumError": "1MB"}]}}, "defaultConfiguration": "production"},
    "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "community:build"}}
  }}}
